@page
@model SchoolRazorApp.Pages.Students.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="text"
               asp-for="SearchString"
               class="form-control"
               placeholder="Tìm theo mã, họ tên hoặc email..." />
    </div>

    <div class="col-md-2">
        <button type="submit"
                class="btn btn-primary w-100">
            Tìm kiếm
        </button>
    </div>

    <div class="col-md-2">
        <a class="btn btn-outline-secondary w-100"
           asp-page="Index">
            Xoá lọc
        </a>
    </div>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-page="Index"
                   asp-route-sortOrder="@Model.CodeSort"
                   asp-route-searchString="@Model.SearchString">
                    Mã SV
                </a>
            </th>
            <th>
                @Html.DisplayNameFor(model => Model.Students[0].LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => Model.Students[0].FirstName)
            </th>
            <th>
                <a asp-page="Index"
                   asp-route-sortOrder="@Model.NameSort"
                   asp-route-searchString="@Model.SearchString">
                    Họ và tên
                </a>
            </th>
            <th>
                @Html.DisplayNameFor(model => Model.Students[0].Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => Model.Students[0].Phone)
            </th>
            <th>
                @Html.DisplayNameFor(model => Model.Students[0].EnrollmentDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => Model.Students[0].Enrollments)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Students) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.StudentCode)
            </td>
            <td>
                @Html.DisplayFor(model => item.LastName)
            </td>
            <td>
                @Html.DisplayFor(model => item.FirstName)
            </td>
            <td>
                @Html.DisplayFor(model => item.FullName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.Phone)
            </td>
            <td>
                @Html.DisplayFor(model => item.EnrollmentDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.Enrollments)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.StudentId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.StudentId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.StudentId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

<nav>
    <ul class="pagination">

        <li class="page-item @(Model.Students.HasPreviousPage ? "" : "disabled")">
            <a class="page-link"
               asp-page="Index"
               asp-route-pageIndex="@(Model.Students.PageIndex - 1)"
               asp-route-sortOrder="@Model.SortOrder"
               asp-route-searchString="@Model.SearchString">
                &laquo; Trước
            </a>
        </li>

        @for (var i = 1; i <= Model.Students.TotalPages; i++)
        {
            <li class="page-item @(i == Model.Students.PageIndex ? "active" : "")">
                <a class="page-link"
                   asp-page="Index"
                   asp-route-pageIndex="@i"
                   asp-route-sortOrder="@Model.SortOrder"
                   asp-route-searchString="@Model.SearchString">
                    @i
                </a>
            </li>
        }

        <li class="page-item @(Model.Students.HasNextPage ? "" : "disabled")">
            <a class="page-link"
               asp-page="Index"
               asp-route-pageIndex="@(Model.Students.PageIndex + 1)"
               asp-route-sortOrder="@Model.SortOrder"
               asp-route-searchString="@Model.SearchString">
                Sau &raquo;
            </a>
        </li>

    </ul>
</nav>

<p class="text-muted small">
    Trang @Model.Students.PageIndex / @Model.Students.TotalPages —
    tổng @Model.Students.TotalItems sinh viên.
</p>
